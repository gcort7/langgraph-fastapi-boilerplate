# Shared secret for the LiteLLM proxy. Must match LITELLM_MASTER_KEY in
# deploy/litellm/.env. The application never holds provider credentials.
LLM_API_KEY="sk-local-dev-only-replace-me"

# Model alias declared in deploy/litellm/config.yaml, not a vendor model name.
LLM_MODEL="default"
LLM_BASE_URL="http://litellm:4000/v1"
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Default cap on generate/judge rounds per request.
MAX_ITERATIONS=3

# text for local development, json for deployed environments
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# JSON array of allowed origins, e.g. ["https://app.example.com"]
CORS_ALLOW_ORIGINS=["*"]

OTEL_ENABLED=true
OTEL_SERVICE_NAME="agent-service"
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
