# Credentials for the LiteLLM proxy container. Copy to `.env` and fill in.
# The application never sees provider keys: it authenticates to the proxy with
# LITELLM_MASTER_KEY and the proxy holds the upstream credentials.

# Shared secret between the application and the proxy. Must match LLM_API_KEY
# in the root .env. Generate one with: openssl rand -hex 32
LITELLM_MASTER_KEY="sk-local-dev-only-replace-me"

# Encrypts credentials the proxy stores in Postgres. Changing it invalidates them.
LITELLM_SALT_KEY="sk-salt-replace-me"

# Upstream provider credentials, referenced by deploy/litellm/config.yaml.
OPENAI_API_KEY="Put your OpenAI API key here"

DATABASE_URL="postgresql://litellm:litellm@litellm-db:5432/litellm"
STORE_MODEL_IN_DB="True"

# Send the proxy's own traces to the collector.
OTEL_EXPORTER="otlp_http"
OTEL_ENDPOINT="http://otel-collector:4318/v1/traces"
